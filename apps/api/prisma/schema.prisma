// Donaive Core — PostgreSQL schema aislado (donaive_core)
// No modifica tablas del backend legacy en schema public.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["donaive_core", "ad_licoreria"]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  active
  inactive
  suspended
  archived

  @@schema("donaive_core")
}

enum ProjectCategory {
  pharmacy
  drugstore
  hardware
  liquor_store
  liquor_and_grocery
  grocery
  restaurant
  retail
  services
  custom

  @@schema("donaive_core")
}

enum ProjectStatus {
  draft
  provisioning
  active
  paused
  suspended
  archived

  @@schema("donaive_core")
}

enum TemplateStatus {
  draft
  active
  deprecated
  archived

  @@schema("donaive_core")
}

enum TemplateVersionStatus {
  draft
  published
  deprecated
  yanked

  @@schema("donaive_core")
}

enum ProjectInstanceStatus {
  provisioning
  active
  paused
  suspended
  decommissioned

  @@schema("donaive_core")
}

enum InstanceVersionStatus {
  active
  superseded
  rolled_back

  @@schema("donaive_core")
}

enum CustomizationType {
  branding
  logo
  colors
  display_name
  module_toggle
  configuration
  behavior
  custom_field
  other

  @@schema("donaive_core")
}

enum CustomizationSource {
  client_request
  donaive_dev
  import
  migration
  system_default

  @@schema("donaive_core")
}

enum ModuleKey {
  pos
  inventory
  purchases
  expenses
  customers
  suppliers
  reports
  finance
  accounts_receivable
  accounts_payable
  offline
  ai

  @@schema("donaive_core")
}

enum ModuleStatus {
  draft
  active
  deprecated
  archived

  @@schema("donaive_core")
}

enum UpdateStatus {
  draft
  published
  deprecated
  yanked

  @@schema("donaive_core")
}

enum UpdateTargetMode {
  project
  projects
  category
  compatible
  none

  @@schema("donaive_core")
}

enum ProjectUpdateStatus {
  assigned
  approved
  installing
  installed
  failed
  rolled_back
  skipped

  @@schema("donaive_core")
}

enum PlanTier {
  basic
  professional
  enterprise
  custom

  @@schema("donaive_core")
}

enum PlanStatus {
  draft
  active
  deprecated
  archived

  @@schema("donaive_core")
}

enum LicenseStatus {
  active
  trial
  grace
  past_due
  expired
  suspended
  revoked

  @@schema("donaive_core")
}

enum EntitlementSource {
  plan
  addon
  trial
  custom
  promotion

  @@schema("donaive_core")
}

enum SubscriptionStatus {
  active
  trial
  past_due
  expired
  suspended
  cancelled

  @@schema("donaive_core")
}

enum CommercialLifecycleStatus {
  active
  trial
  past_due
  expired
  suspended
  cancelled

  @@schema("donaive_core")
}

enum ProjectDomainType {
  subdomain
  custom_domain

  @@schema("donaive_core")
}

enum ProjectDomainStatus {
  pending
  active
  error
  disabled

  @@schema("donaive_core")
}

enum ProjectUserRole {
  project_admin
  manager
  user
  viewer

  @@schema("donaive_core")
}

enum ProjectUserStatus {
  active
  invited
  suspended
  removed

  @@schema("donaive_core")
}

enum PlatformRole {
  donaive_admin
  donaive_operator
  project_admin
  project_manager
  project_user
  project_viewer
  donaive_intelligence
  ai_agent

  @@schema("donaive_core")
}

enum UserStatus {
  active
  invited
  suspended
  deactivated

  @@schema("donaive_core")
}

enum AuditActorType {
  user
  system
  agent
  service
  scheduler

  @@schema("donaive_core")
}

enum AnalyticsSensitivity {
  aggregate
  detailed

  @@schema("donaive_core")
}

enum AgentAccessMode {
  read
  analyze
  suggest
  generate
  prepare

  @@schema("donaive_core")
}

// ─── Identity & Access ───────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  passwordHash String?
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projectUsers    ProjectUser[]
  roleAssignments UserRoleAssignment[]

  @@schema("donaive_core")
}

model Capability {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?
  sensitive   Boolean @default(false)

  roleCapabilities RoleCapability[]

  @@schema("donaive_core")
}

model RoleCapability {
  id           String       @id @default(uuid())
  role         PlatformRole
  capabilityId String
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([role, capabilityId])
  @@schema("donaive_core")
}

model UserRoleAssignment {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           PlatformRole
  organizationId String?
  projectId      String?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([projectId])
  @@schema("donaive_core")
}

// ─── Platform entities ───────────────────────────────────────────────────────

model Organization {
  id        String             @id @default(uuid())
  name      String
  legalName String?
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  projects      Project[]
  licenses      License[]
  subscriptions Subscription[]

  @@schema("donaive_core")
}

model Project {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  commercialName   String
  technicalSlug    String          @unique
  category         ProjectCategory
  status           ProjectStatus   @default(draft)
  templateId       String?
  template         Template?       @relation(fields: [templateId], references: [id])
  currentVersionId String?
  primaryDomain    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  instances       ProjectInstance[]
  customizations  ProjectCustomization[]
  projectModules  ProjectModule[]
  projectUpdates  ProjectUpdate[]
  licenses        License[]
  subscriptions   Subscription[]
  domains         ProjectDomain[]
  projectUsers    ProjectUser[]
  entitlements    Entitlement[]
  analyticsSnapshots AnalyticsSnapshot[]
  agentContexts   AgentContext[]

  @@index([organizationId])
  @@index([category])
  @@schema("donaive_core")
}

model Template {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  category         ProjectCategory
  description      String?
  status           TemplateStatus @default(draft)
  currentVersionId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  versions  TemplateVersion[]
  projects  Project[]
  instances ProjectInstance[]

  @@schema("donaive_core")
}

model TemplateVersion {
  id           String                @id @default(uuid())
  templateId   String
  template     Template              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version      String
  status       TemplateVersionStatus @default(draft)
  releaseNotes String?
  createdAt    DateTime              @default(now())

  instances       ProjectInstance[]
  instanceVersions InstanceVersion[]

  @@unique([templateId, version])
  @@schema("donaive_core")
}

model ProjectInstance {
  id                String                @id @default(uuid())
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId        String
  template          Template              @relation(fields: [templateId], references: [id])
  templateVersionId String
  templateVersion   TemplateVersion       @relation(fields: [templateVersionId], references: [id])
  status            ProjectInstanceStatus @default(provisioning)
  currentInstanceVersionId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  instanceVersions InstanceVersion[]

  @@index([projectId])
  @@schema("donaive_core")
}

model InstanceVersion {
  id                String                @id @default(uuid())
  projectInstanceId String
  projectInstance   ProjectInstance       @relation(fields: [projectInstanceId], references: [id], onDelete: Cascade)
  projectId         String
  version           String
  status            InstanceVersionStatus @default(active)
  templateVersionId String?
  templateVersion   TemplateVersion?      @relation(fields: [templateVersionId], references: [id])
  adoptedAt         DateTime              @default(now())
  createdAt         DateTime              @default(now())

  @@index([projectId])
  @@schema("donaive_core")
}

model ProjectCustomization {
  id        String              @id @default(uuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      CustomizationType
  key       String
  value     Json
  source    CustomizationSource
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
  @@schema("donaive_core")
}

model Module {
  id       String       @id @default(uuid())
  key      ModuleKey    @unique
  name     String
  category ProjectCategory?
  version  String?
  status   ModuleStatus @default(active)

  projectModules ProjectModule[]
  entitlements   Entitlement[]

  @@schema("donaive_core")
}

model ProjectModule {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module  @relation(fields: [moduleId], references: [id])
  enabled   Boolean @default(true)
  version   String?

  @@unique([projectId, moduleId])
  @@schema("donaive_core")
}

model Update {
  id                   String        @id @default(uuid())
  name                 String
  moduleKey            ModuleKey
  fromVersion          String?
  toVersion            String
  compatibleCategories ProjectCategory[]
  compatibleModules    ModuleKey[]
  status               UpdateStatus  @default(draft)
  releaseNotes         String?
  createdAt            DateTime      @default(now())
  publishedAt          DateTime?

  release        UpdateRelease?
  targets        UpdateTarget[]
  projectUpdates ProjectUpdate[]

  @@schema("donaive_core")
}

model UpdateRelease {
  id         String   @id @default(uuid())
  updateId   String   @unique
  update     Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  releasedAt DateTime @default(now())
  releasedBy String?

  @@schema("donaive_core")
}

model UpdateTarget {
  id         String           @id @default(uuid())
  updateId   String
  update     Update           @relation(fields: [updateId], references: [id], onDelete: Cascade)
  mode       UpdateTargetMode
  projectIds String[]
  category   ProjectCategory?

  @@schema("donaive_core")
}

model ProjectUpdate {
  id            String              @id @default(uuid())
  updateId      String
  update        Update              @relation(fields: [updateId], references: [id])
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        ProjectUpdateStatus @default(assigned)
  assignedBy    String?
  assignedAt    DateTime            @default(now())
  approvedAt    DateTime?
  installedAt   DateTime?
  fromVersion   String?
  toVersion     String?
  failureReason String?
  rollbackOfId  String?

  @@index([projectId])
  @@index([updateId])
  @@schema("donaive_core")
}

model Plan {
  id              String     @id @default(uuid())
  name            String
  tier            PlanTier
  description     String?
  status          PlanStatus @default(draft)
  includedModules ModuleKey[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  licenses      License[]
  subscriptions Subscription[]

  @@schema("donaive_core")
}

model License {
  id                 String        @id @default(uuid())
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id])
  planId             String?
  plan               Plan?         @relation(fields: [planId], references: [id])
  status             LicenseStatus @default(active)
  startDate          DateTime      @db.Date
  endDate            DateTime?     @db.Date
  lifecycleStatus    CommercialLifecycleStatus @default(active)
  gracePeriodEndsAt  DateTime?
  deviceLimit        Int?
  activationRef      String?
  renewalRef         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  entitlements Entitlement[]

  @@index([projectId])
  @@index([organizationId])
  @@schema("donaive_core")
}

model Entitlement {
  id        String            @id @default(uuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  licenseId String?
  license   License?          @relation(fields: [licenseId], references: [id])
  moduleId  String?
  module    Module?           @relation(fields: [moduleId], references: [id])
  moduleKey ModuleKey?
  enabled   Boolean           @default(true)
  source    EntitlementSource
  limits    Json?

  @@index([projectId])
  @@schema("donaive_core")
}

model Subscription {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id])
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id])
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(active)
  startDate       DateTime           @db.Date
  endDate         DateTime?          @db.Date
  lifecycleStatus CommercialLifecycleStatus @default(active)
  gracePeriodEndsAt DateTime?
  billingCycleRef String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@schema("donaive_core")
}

model ProjectDomain {
  id         String              @id @default(uuid())
  projectId  String
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostname   String              @unique
  type       ProjectDomainType
  status     ProjectDomainStatus @default(pending)
  isPrimary  Boolean             @default(false)
  sslStatus  String?
  verifiedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([projectId])
  @@schema("donaive_core")
}

model ProjectUser {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectUserRole
  status    ProjectUserStatus @default(active)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, projectId])
  @@index([projectId])
  @@schema("donaive_core")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id             String         @id @default(uuid())
  actorType      AuditActorType
  actorId        String?
  action         String
  entityType     String
  entityId       String
  projectId      String?
  organizationId String?
  before         Json?
  after          Json?
  metadata       Json?
  reason         String?
  approvalId     String?
  agentRunId     String?
  capability     String?
  createdAt      DateTime       @default(now())

  @@index([projectId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@schema("donaive_core")
}

// ─── Analytics & AI (preparación, sin autonomía) ─────────────────────────────

model AnalyticsSnapshot {
  id             String               @id @default(uuid())
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  category       ProjectCategory
  periodStart    DateTime
  periodEnd      DateTime
  metrics        Json
  sensitivity    AnalyticsSensitivity @default(aggregate)
  exportedAt     DateTime             @default(now())

  @@index([projectId])
  @@index([category])
  @@schema("donaive_core")
}

model AgentContext {
  id          String   @id @default(uuid())
  agentRunId  String   @unique
  actorId     String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  approvalId  String?
  capabilities String[]
  readOnly    Boolean  @default(true)
  createdAt   DateTime @default(now())

  projectAccess AgentProjectAccess?

  @@schema("donaive_core")
}

model AgentProjectAccess {
  id             String          @id @default(uuid())
  agentContextId String          @unique
  agentContext   AgentContext    @relation(fields: [agentContextId], references: [id], onDelete: Cascade)
  projectId      String
  organizationId String
  readOnly       Boolean         @default(true)
  modes          AgentAccessMode[]

  permissions AgentPermission[]

  @@schema("donaive_core")
}

model AgentPermission {
  id                   String             @id @default(uuid())
  agentProjectAccessId String
  agentProjectAccess   AgentProjectAccess @relation(fields: [agentProjectAccessId], references: [id], onDelete: Cascade)
  capability           String
  requiresApproval     Boolean            @default(false)

  @@schema("donaive_core")
}

model OfflineSyncRequirement {
  id                   String  @id @default(uuid())
  projectId            String  @unique
  localDatabase        Boolean @default(true)
  syncEngine           Boolean @default(true)
  offlineQueue         Boolean @default(true)
  conflictResolution   Boolean @default(true)
  documentedOnly       Boolean @default(true)

  @@schema("donaive_core")
}

// ═══════════════════════════════════════════════════════════════════════════
// A&D Licorería & Bodegón — schema operativo (ad_licoreria)
// Aislado de donaive_core. Migración aditiva. Ver docs/ad-licoreria/BACKEND-FASE1-PLAN.md
// ═══════════════════════════════════════════════════════════════════════════

enum AdOperatorRole {
  admin
  supervisor
  cajero
  mesonera
  inventario
  tv

  @@schema("ad_licoreria")
}

enum AdInventoryMovementType {
  IN
  OUT
  ADJUST
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  SERVE
  VOID_REVERSAL
  PURCHASE
  COUNT

  @@schema("ad_licoreria")
}

enum AdTransferStatus {
  DRAFT
  PRELIMINARY
  CONFIRMED
  RECEIVED
  CANCELLED

  @@schema("ad_licoreria")
}

enum AdSaleStatus {
  draft
  preliminary
  completed
  voided

  @@schema("ad_licoreria")
}

enum AdAccountStatus {
  ABIERTA
  PREPAGADA
  PARCIALMENTE_PAGADA
  CERRADA
  ANULADA

  @@schema("ad_licoreria")
}

enum AdPrepaidStatus {
  ACTIVE
  PARTIAL
  DEPLETED
  VOIDED

  @@schema("ad_licoreria")
}

enum AdClosureStatus {
  OPEN
  CLOSED
  VOIDED

  @@schema("ad_licoreria")
}

enum AdMoneyCurrency {
  USD
  BS

  @@schema("ad_licoreria")
}

/// Tenant operativo A&D (1:1 conceptual con Project de donaive_core).
model AdTenant {
  id        String   @id @default(uuid())
  /// UUID del Project en donaive_core (sin FK cross-schema en F1 — integridad app-level).
  projectId String   @unique
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  /// Tasa informativa; NO implica conversión automática USD↔Bs.
  exchangeRateUsdToBs Decimal? @db.Decimal(18, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses   AdWarehouse[]
  operators    AdOperator[]
  categories   AdCategory[]
  products     AdProduct[]
  customers    AdCustomer[]
  sales        AdSale[]
  accounts     AdAccount[]
  tables       AdTableSpace[]
  prepaids     AdPrepaid[]
  transfers    AdStockTransfer[]
  cashClosures AdCashClosure[]
  invClosures  AdInventoryClosure[]
  auditEvents  AdAuditEvent[]

  @@schema("ad_licoreria")
}

model AdWarehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    AdTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operators       AdOperator[]
  stocks          AdStock[]
  movements       AdInventoryMovement[]
  sales           AdSale[]
  accounts        AdAccount[]
  transfersFrom   AdStockTransfer[] @relation("TransferFrom")
  transfersTo     AdStockTransfer[] @relation("TransferTo")
  cashClosures    AdCashClosure[]
  invClosures     AdInventoryClosure[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@schema("ad_licoreria")
}

model AdOperator {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       AdTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Opcional en F1 — vínculo a donaive_core.User
  userId       String?
  username     String
  name         String
  role         AdOperatorRole
  active       Boolean        @default(true)
  warehouseId  String?
  warehouse    AdWarehouse?   @relation(fields: [warehouseId], references: [id])
  passwordHash String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  permissions AdOperatorPermission[]
  sales       AdSale[]
  accounts    AdAccount[]         @relation("AccountMesonera")
  auditEvents AdAuditEvent[]

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([userId])
  @@index([warehouseId])
  @@schema("ad_licoreria")
}

model AdOperatorPermission {
  id         String     @id @default(uuid())
  operatorId String
  operator   AdOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  /// Ej: pos.sell, pos.shortage_override, inventory.read
  permission String

  @@unique([operatorId, permission])
  @@index([permission])
  @@schema("ad_licoreria")
}

model AdCategory {
  id       String    @id @default(uuid())
  tenantId String
  tenant   AdTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  active   Boolean   @default(true)
  products AdProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@schema("ad_licoreria")
}

model AdProduct {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        AdTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      AdCategory? @relation(fields: [categoryId], references: [id])
  name          String
  brand         String?
  sku           String?
  barcode       String?
  description   String?
  baseUnitLabel String   @default("u")
  minStockBase  Decimal  @default(0) @db.Decimal(18, 4)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  presentations AdPresentation[]
  stocks        AdStock[]
  movements     AdInventoryMovement[]
  saleLines     AdSaleLine[]
  accountLines  AdAccountLine[]
  transferLines AdStockTransferLine[]

  @@index([tenantId])
  @@index([categoryId])
  @@schema("ad_licoreria")
}

model AdPresentation {
  id                   String    @id @default(uuid())
  productId            String
  product              AdProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                 String
  code                 String?
  /// Factor de conversión a unidad base (configurable).
  unitsPerPresentation Decimal   @db.Decimal(18, 6)
  priceUsd             Decimal   @db.Decimal(18, 4)
  priceBs              Decimal   @db.Decimal(18, 4)
  minPriceUsd          Decimal?  @db.Decimal(18, 4)
  maxPriceUsd          Decimal?  @db.Decimal(18, 4)
  sku                  String?
  barcode              String?
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  saleLines     AdSaleLine[]
  accountLines  AdAccountLine[]
  transferLines AdStockTransferLine[]

  @@index([productId])
  @@schema("ad_licoreria")
}

model AdStock {
  id          String      @id @default(uuid())
  warehouseId String
  warehouse   AdWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     AdProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyBase     Decimal     @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime    @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
  @@schema("ad_licoreria")
}

model AdInventoryMovement {
  id              String                  @id @default(uuid())
  warehouseId     String
  warehouse       AdWarehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId       String
  product         AdProduct               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            AdInventoryMovementType
  qtyBase         Decimal                 @db.Decimal(18, 4)
  presentationId  String?
  qtyPresentation Decimal?
  operatorId      String?
  reference       String?
  reason          String?
  createdAt       DateTime                @default(now())

  @@index([warehouseId, createdAt])
  @@index([productId])
  @@schema("ad_licoreria")
}

model AdStockTransfer {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          AdTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentNumber  String
  fromWarehouseId String
  fromWarehouse   AdWarehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     AdWarehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          AdTransferStatus @default(DRAFT)
  createdById     String?
  reason          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  confirmedAt     DateTime?
  receivedAt      DateTime?

  lines AdStockTransferLine[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@schema("ad_licoreria")
}

model AdStockTransferLine {
  id             String         @id @default(uuid())
  transferId     String
  transfer       AdStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId      String
  product        AdProduct      @relation(fields: [productId], references: [id])
  presentationId String?
  presentation   AdPresentation? @relation(fields: [presentationId], references: [id])
  qty            Decimal        @db.Decimal(18, 4)
  qtyBase        Decimal        @db.Decimal(18, 4)

  @@index([transferId])
  @@schema("ad_licoreria")
}

model AdCustomer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    AdTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  phone     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    AdSale[]
  accounts AdAccount[]
  prepaids AdPrepaid[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, document])
  @@schema("ad_licoreria")
}

model AdSale {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        AdTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     AdWarehouse  @relation(fields: [warehouseId], references: [id])
  operatorId    String
  operator      AdOperator   @relation(fields: [operatorId], references: [id])
  customerId    String?
  customer      AdCustomer?  @relation(fields: [customerId], references: [id])
  receiptNumber String
  status        AdSaleStatus @default(draft)
  totalUsd      Decimal      @db.Decimal(18, 4)
  totalBs       Decimal      @db.Decimal(18, 4)
  discountUsd   Decimal      @default(0) @db.Decimal(18, 4)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  voidedAt      DateTime?

  lines    AdSaleLine[]
  payments AdSalePayment[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, createdAt])
  @@index([warehouseId])
  @@index([operatorId])
  @@schema("ad_licoreria")
}

model AdSaleLine {
  id             String         @id @default(uuid())
  saleId         String
  sale           AdSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        AdProduct      @relation(fields: [productId], references: [id])
  presentationId String
  presentation   AdPresentation @relation(fields: [presentationId], references: [id])
  qty            Decimal        @db.Decimal(18, 4)
  qtyBase        Decimal        @db.Decimal(18, 4)
  /// Snapshot histórico — no recalcular desde catálogo.
  unitPriceUsd   Decimal        @db.Decimal(18, 4)
  unitPriceBs    Decimal        @db.Decimal(18, 4)
  lineTotalUsd   Decimal        @db.Decimal(18, 4)
  lineTotalBs    Decimal        @db.Decimal(18, 4)

  @@index([saleId])
  @@schema("ad_licoreria")
}

model AdSalePayment {
  id        String          @id @default(uuid())
  saleId    String
  sale      AdSale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String
  currency  AdMoneyCurrency
  amount    Decimal         @db.Decimal(18, 4)
  reference String?
  bank      String?

  @@index([saleId])
  @@schema("ad_licoreria")
}

model AdTableSpace {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      AdTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  active      Boolean  @default(true)
  warehouseId String?
  accounts    AdAccount[]

  @@index([tenantId])
  @@schema("ad_licoreria")
}

model AdAccount {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        AdTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     AdWarehouse     @relation(fields: [warehouseId], references: [id])
  tableId       String?
  table         AdTableSpace?   @relation(fields: [tableId], references: [id])
  mesoneraId    String?
  mesonera      AdOperator?     @relation("AccountMesonera", fields: [mesoneraId], references: [id])
  customerId    String?
  customer      AdCustomer?     @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  status        AdAccountStatus @default(ABIERTA)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  closedAt      DateTime?

  lines AdAccountLine[]

  @@index([tenantId])
  @@index([warehouseId])
  @@index([mesoneraId])
  @@schema("ad_licoreria")
}

model AdAccountLine {
  id             String          @id @default(uuid())
  accountId      String
  account        AdAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId      String
  product        AdProduct       @relation(fields: [productId], references: [id])
  presentationId String
  presentation   AdPresentation  @relation(fields: [presentationId], references: [id])
  qtyOrdered     Decimal         @db.Decimal(18, 4)
  qtyServed      Decimal         @default(0) @db.Decimal(18, 4)
  unitPriceUsd   Decimal         @db.Decimal(18, 4)
  unitPriceBs    Decimal         @db.Decimal(18, 4)

  @@index([accountId])
  @@schema("ad_licoreria")
}

model AdPrepaid {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        AdTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      AdCustomer      @relation(fields: [customerId], references: [id])
  /// Token opaco — nunca exponer IDs internos en el QR.
  qrToken       String          @unique
  receiptRef    String?
  status        AdPrepaidStatus @default(ACTIVE)
  totalQtyBase  Decimal         @db.Decimal(18, 4)
  remainingBase Decimal         @db.Decimal(18, 4)
  payload       Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  consumptions AdPrepaidConsumption[]

  @@index([tenantId])
  @@index([customerId])
  @@schema("ad_licoreria")
}

model AdPrepaidConsumption {
  id              String    @id @default(uuid())
  prepaidId       String
  prepaid         AdPrepaid @relation(fields: [prepaidId], references: [id], onDelete: Cascade)
  qtyBase         Decimal   @db.Decimal(18, 4)
  operatorId      String?
  verifiedPhone   String?
  verifiedDocument String?
  createdAt       DateTime  @default(now())

  @@index([prepaidId])
  @@schema("ad_licoreria")
}

model AdCashClosure {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          AdTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       AdWarehouse     @relation(fields: [warehouseId], references: [id])
  operatorId      String
  periodStart     DateTime
  periodEnd       DateTime
  expectedCashUsd Decimal         @db.Decimal(18, 4)
  expectedCashBs  Decimal         @db.Decimal(18, 4)
  countedCashUsd  Decimal         @db.Decimal(18, 4)
  countedCashBs   Decimal         @db.Decimal(18, 4)
  differenceUsd   Decimal         @db.Decimal(18, 4)
  differenceBs    Decimal         @db.Decimal(18, 4)
  status          AdClosureStatus @default(CLOSED)
  snapshot        Json?
  createdAt       DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([warehouseId])
  @@schema("ad_licoreria")
}

model AdInventoryClosure {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      AdTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   AdWarehouse     @relation(fields: [warehouseId], references: [id])
  operatorId  String
  status      AdClosureStatus @default(CLOSED)
  notes       String?
  createdAt   DateTime        @default(now())

  lines AdInventoryClosureLine[]

  @@index([tenantId])
  @@schema("ad_licoreria")
}

model AdInventoryClosureLine {
  id             String             @id @default(uuid())
  closureId      String
  closure        AdInventoryClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)
  productId      String
  theoreticalBase Decimal           @db.Decimal(18, 4)
  physicalBase   Decimal            @db.Decimal(18, 4)
  differenceBase Decimal            @db.Decimal(18, 4)

  @@index([closureId])
  @@schema("ad_licoreria")
}

model AdAuditEvent {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     AdTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operatorId String?
  operator   AdOperator? @relation(fields: [operatorId], references: [id])
  action     String
  entity     String
  entityId   String?
  detail     String?
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@schema("ad_licoreria")
}
