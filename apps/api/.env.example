# PostgreSQL (Render) — NO incluir credenciales reales en el repositorio
# Será proporcionada por el PostgreSQL de Donaive V2 en Render al conectar el servicio.
DATABASE_URL=

# Servidor HTTP (Render inyecta PORT automáticamente)
PORT=3001
NODE_ENV=development

# CORS — orígenes permitidos del frontend (comma-separated)
# Ejemplo producción: https://donaive.com.ve,https://www.donaive.com.ve
# En desarrollo, si está vacío, se permiten todos los orígenes.
CORS_ORIGIN=

# JWT (autenticación Core — configurar en producción, no implementado aún)
JWT_SECRET=

# Schema PostgreSQL del Core (aislamiento del backend legacy en public)
CORE_DB_SCHEMA=donaive_core
