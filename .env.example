# Simula el dominio propio polisur.com.ve en desarrollo local (rutas en /)
# VITE_POLISUR_HOST=true

# Simula dominio propio A&D Licorería (rutas en /) — local/túnel.
# Valor permitido: true (nunca una URL). En el proyecto Vercel `ad-licoreria`
# el hostname ya se detecta en runtime (ad-licoreria*.vercel.app).
# VITE_AD_LICORERIA_HOST=true
# (sin flag ni host A&D, A&D vive en /licoreria y la raíz abre Donaive)

# Simula dominio propio Donaive Software (rutas en /).
# Valor permitido: true. Host Vercel: donaive-software*.vercel.app
# Sin flag: vive en /software sobre el host Donaive.
# VITE_DONAIVE_SOFTWARE_HOST=true

# A&D — fuente de datos (mock | api). Default mock. Para JWT real:
# VITE_AD_DATA_SOURCE=api
# VITE_API_BASE_URL=http://127.0.0.1:3001

# Clave del registro documental POLISUR (/medios en polisur.com.ve)
POLISUR_MEDIOS_CLAVE=polisur-registro-2026

# Solo producción/Vercel (commit a GitHub):
# GITHUB_TOKEN=
# POLISUR_MEDIOS_BRANCH=main
# POLISUR_MEDIOS_REPO=JosuePuentes/frontenddonaive
# POLISUR_SITE_BRANCH=main
# POLISUR_PREINSCRIPCIONES_BRANCH=main
